# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_value

# Optional — comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Optional — enables AI features in the CRM
ANTHROPIC_API_KEY=your_api_key_here

# Optional — Stripe (donations + service-fee payment links)
# STRIPE_WEBHOOK_SECRET is required if you use Stripe at all — without it,
# the webhook endpoint will refuse all events rather than trust unsigned payloads.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret
STRIPE_SUCCESS_URL=https://yourdomain.com/donate/thank-you
STRIPE_CANCEL_URL=https://yourdomain.com

# Optional — outbound email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Lifeway Programs
SMTP_FROM_EMAIL=

# Optional — SMS (OpenPhone)
OPENPHONE_API_KEY=
OPENPHONE_PHONE_NUMBER_ID=

# Optional — Zoom Server-to-Server OAuth (telehealth meeting links)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Optional — Google Calendar sync
GOOGLE_CALENDAR_ID=primary

# Optional — used to build links in outbound emails
CRM_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
